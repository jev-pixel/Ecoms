# Copy to .env before running `docker compose up`.
# This .env is read by docker-compose.yml (env_file) AND by Django inside
# the container (settings.py loads it too, so keep one source of truth).

# ---- Django ----
SECRET_KEY=replace-this-with-a-real-random-secret-key
DEBUG=False
# Add every hostname/IP people will use to reach the site, comma-separated.
# e.g. localhost,127.0.0.1,my-shop.example.com,203.0.113.10
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=

# ---- Postgres (used by both the 'db' and 'web' services in compose) ----
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-this-password

# NOTE: DATABASE_URL itself is set automatically inside docker-compose.yml
# from the POSTGRES_* vars above, so you don't need to set it here.
