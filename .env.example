# Copy this file to .env for local development and fill in real values.
# In production, set these as environment variables in your host's dashboard
# (Railway/Render project settings) instead of committing a .env file.

# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-this-with-a-real-random-secret-key

# True for local dev only. Always False in production.
DEBUG=True

# Comma-separated list of hosts allowed to serve this app.
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset locally to fall back to SQLite. In production, your host
# will usually inject this automatically once you attach a Postgres database.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# DATABASE_URL=

# Comma-separated list of origins allowed to make cross-origin requests
# to the API (e.g. a separate frontend domain, if you add one later).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
